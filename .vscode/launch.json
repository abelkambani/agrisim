{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Main Simulation",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/agrisim/main.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Streamlit: Dashboard",
            "type": "python",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/agrisim/dashboard/app.py"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
